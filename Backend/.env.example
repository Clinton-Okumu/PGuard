# Server Configuration
PORT=8080
HOST=0.0.0.0

# Database Configuration (supports either full DATABASE_URL or individual params)
DATABASE_URL=postgres://clinton:your_password@127.0.0.1:5432/pguard_db?sslmode=disable
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_USER=clinton
# DB_PASSWORD=your_password
# DB_NAME=pguard_db

# JWT & Session Settings
JWT_SECRET=pguard-dev-jwt-super-secure-secret-key-32-chars
JWT_ACCESS_DURATION_MINUTES=30
JWT_REFRESH_DURATION_DAYS=60

# Google OAuth
# Set DEV_MOCK_AUTH=true to allow mock tokens during local development & Postman testing
DEV_MOCK_AUTH=true
# Comma-separated list of allowed Google Client IDs (leave empty in dev to allow any valid Google ID token)
GOOGLE_CLIENT_IDS=

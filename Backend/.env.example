# Server Configuration
PORT=8080
HOST=0.0.0.0

# Database Configuration (supports either full DATABASE_URL or individual params)
# For Neon Lakebase Postgres, use the pooled connection string for DATABASE_URL
# and the direct connection string for DATABASE_URL_UNPOOLED (used by AutoMigrate).
DATABASE_URL=postgres://clinton:your_password@127.0.0.1:5432/pguard_db?sslmode=disable
DATABASE_URL_UNPOOLED=
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_USER=clinton
# DB_PASSWORD=your_password
# DB_NAME=pguard_db

# JWT & Session Settings
JWT_SECRET=pguard-dev-jwt-super-secure-secret-key-32-chars
JWT_ACCESS_DURATION_MINUTES=10080
JWT_REFRESH_DURATION_DAYS=60

# Google OAuth
# Set DEV_MOCK_AUTH=true to allow mock tokens during local development & Postman testing
DEV_MOCK_AUTH=true
# Comma-separated list of allowed Google Client IDs (leave empty in dev to allow any valid Google ID token)
GOOGLE_CLIENT_IDS=

# CORS (comma-separated allowed origins; leave empty in production, * allowed only when DEV_MOCK_AUTH=true)
CORS_ALLOWED_ORIGINS=

# Resend Email Service
RESEND_API_KEY=
RESEND_FROM_EMAIL="PGuard <onboarding@resend.dev>"
RESEND_SANDBOX_FALLBACK_EMAIL=
SERVER_BASE_URL=http://localhost:8080


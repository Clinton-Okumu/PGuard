---
interface Props {
  size?: number;
  showText?: boolean;
}

const { size = 36, showText = true } = Astro.props;
---

<a href="/" class="brand-logo" aria-label="PGuard Home">
  <div class="logo-icon-wrapper" style={`width: ${size}px; height: ${size}px;`}>
    <!-- Official PGuard Vector Shield & Globe Logo from mobile app -->
    <svg
      viewBox="0 0 64 64"
      width={size}
      height={size}
      class="logo-svg"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
    >
      <!-- Coral Rounded Background -->
      <rect width="64" height="64" rx="16" fill="var(--color-primary)" />

      <!-- Globe Meridians & Latitudes -->
      <path
        d="M30 6 C16.75 6 6 16.75 6 30 C6 43.25 16.75 54 30 54 C35.2 54 39.9 52.3 43.8 49.5"
        stroke="var(--color-on-primary)"
        stroke-width="2.5"
        stroke-linecap="round"
      />
      <path
        d="M49.5 43.8 C52.3 39.9 54 35.2 54 30 C54 16.75 43.25 6 30 6 Z"
        stroke="var(--color-on-primary)"
        stroke-width="2.5"
        stroke-linecap="round"
      />
      <path
        d="M6.5 30 L28 30"
        stroke="var(--color-on-primary)"
        stroke-width="2.2"
        stroke-linecap="round"
      />
      <path
        d="M11 18 C16 21 24 22 30 22 C37 22 45 21 49 18"
        stroke="var(--color-on-primary)"
        stroke-width="2.2"
        stroke-linecap="round"
      />
      <path
        d="M11 42 C16 39 21 38 26 38"
        stroke="var(--color-on-primary)"
        stroke-width="2.2"
        stroke-linecap="round"
      />
      <path
        d="M30 6 C22 14 18 22 18 30 C18 38 22 46 30 54"
        stroke="var(--color-on-primary)"
        stroke-width="2.2"
        stroke-linecap="round"
      />
      <path
        d="M30 6 C34.5 10.5 38 16 39.8 22"
        stroke="var(--color-on-primary)"
        stroke-width="2.2"
        stroke-linecap="round"
      />
      <path
        d="M30 6 L30 22"
        stroke="var(--color-on-primary)"
        stroke-width="2.2"
        stroke-linecap="round"
      />

      <!-- Shield Cutout Mask -->
      <path
        d="M27 24 L49 24 C49 38 38 48 38 48 C38 48 27 38 27 24 Z"
        fill="var(--color-primary)"
        stroke="var(--color-primary)"
        stroke-width="7"
        stroke-linecap="round"
        stroke-linejoin="round"
      />

      <!-- Outer Shield Outline -->
      <path
        d="M27 24 L49 24 C49 38 38 48 38 48 C38 48 27 38 27 24 Z"
        stroke="var(--color-on-primary)"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      />

      <!-- Inner Shield Inset -->
      <path
        d="M31 28 L45 28 C45 36.5 38 43.5 38 43.5 C38 43.5 31 36.5 31 28 Z"
        stroke="var(--color-on-primary)"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
  </div>
  {showText && <span class="brand-name">PGuard</span>}
</a>

<style>
  .brand-logo {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    user-select: none;
    transition: opacity var(--transition-fast);
  }

  .brand-logo:hover {
    opacity: 0.9;
  }

  .logo-icon-wrapper {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-sm);
    overflow: hidden;
    flex-shrink: 0;
    border: 1.5px solid var(--color-brand-glass-border);
    box-shadow: 0 4px 14px var(--shadow-canvas-sm);
  }

  .logo-svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .brand-name {
    font-size: 1.28rem;
    color: var(--color-text-primary);
    font-weight: 800;
    letter-spacing: -0.4px;
  }
</style>

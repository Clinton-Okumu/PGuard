---
---

<section class="features-section">
  <div class="features-container">
    <!-- Section Header -->
    <div class="features-header">
      <h2 class="features-title">The secret is science, not willpower.</h2>
    </div>

    <!-- Row 1: Remove temptation (Phone Left + Floating Pills, Text Right) -->
    <div class="feature-row">
      <div class="feature-visual">
        <div class="phone-wrap">
          <div class="feature-phone bezel-coral">
            <div class="feature-screen">
              <img
                src="/blocklist.webp"
                alt="PGuard website and keyword blocklist screen"
                class="feature-img"
                loading="lazy"
              />
            </div>
          </div>

          <!-- Floating Filter Pills -->
          <div class="pill-tag pill-top-right" aria-hidden="true">
            <span class="pill-shield">✓</span>
            <span>60s Typing Guard</span>
          </div>

          <div class="pill-tag pill-mid-left" aria-hidden="true">
            <span class="pill-shield">✓</span>
            <span>Block websites</span>
          </div>

          <div class="pill-tag pill-mid-right" aria-hidden="true">
            <span class="pill-shield">✓</span>
            <span>Block keywords</span>
          </div>

          <div class="pill-tag pill-bottom-left" aria-hidden="true">
            <span class="pill-new-badge">NEW</span>
            <span class="pill-shield">✓</span>
            <span>Block Shorts &amp; Reels</span>
          </div>
        </div>
      </div>

      <div class="feature-copy-block">
        <h3 class="feature-heading heading-coral">Remove temptation</h3>
        <p class="feature-body">
          The PGuard filter blocks adult websites, addictive short-form feeds (Shorts, Reels, TikTok), and custom keywords on-device—protecting both your wellbeing and recovery.
        </p>
      </div>
    </div>

    <!-- Row 2: Lock in your guardrails (Text Left, Phone Right + Pop-out Card) -->
    <div class="feature-row feature-row-reverse">
      <div class="feature-visual">
        <div class="phone-wrap">
          <div class="feature-phone bezel-coral">
            <div class="feature-screen">
              <img
                src="/blocking.webp"
                alt="PGuard real-time blocking and accountability screen"
                class="feature-img"
                loading="lazy"
              />
            </div>
          </div>

          <!-- Floating Pop-out Card -->
          <div class="feature-popout popout-left" aria-hidden="true">
            <div class="popout-icon popout-icon-coral">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
                <path d="M7 11V7a5 5 0 0 1 10 0v4" />
              </svg>
            </div>
            <div class="popout-meta">
              <div class="popout-label">Focus Mode</div>
              <div class="popout-sub">Add friction before rules can be changed.</div>
              <div class="popout-track">
                <div class="popout-fill fill-coral"></div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="feature-copy-block">
        <h3 class="feature-heading heading-coral">Lock in your guardrails</h3>
        <p class="feature-body">
          When an urge or distraction hits, friction buys you time. Focus Mode, 2-minute Lockdowns, and typing challenges stop impulsive relapses and mindless scrolling.
        </p>
      </div>
    </div>

    <!-- Row 3: Track your progress (Phone Left + Pop-out Card, Text Right) -->
    <div class="feature-row">
      <div class="feature-visual">
        <div class="phone-wrap">
          <div class="feature-phone bezel-coral">
            <div class="feature-screen">
              <img
                src="/progress.webp"
                alt="PGuard streak and progress tracking screen"
                class="feature-img"
                loading="lazy"
              />
            </div>
          </div>

          <!-- Floating Pop-out Card -->
          <div class="feature-popout popout-center" aria-hidden="true">
            <div class="popout-icon popout-icon-coral">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 12h-4l-3 9L9 3l-3 9H2" />
              </svg>
            </div>
            <div class="popout-meta">
              <div class="popout-label">Weekly Consistency</div>
              <div class="popout-sub">100% clean streak &bull; Urges won</div>
              <div class="popout-track">
                <div class="popout-fill fill-coral"></div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="feature-copy-block">
        <h3 class="feature-heading heading-coral">Track your progress</h3>
        <p class="feature-body">
          The power of positive momentum. PGuard tracks your clean days, screen-habit boundaries, urges won, and weekly consistency from day one.
        </p>
      </div>
    </div>

    <!-- Bottom Centered Pill CTA -->
    <div class="features-cta-wrap">
      <a href="#download" class="features-cta-btn">
        Download now
      </a>
    </div>
  </div>
</section>

<style>
  .features-section {
    width: 100%;
    background-color: var(--color-bg);
    padding: 96px 0 40px;
    overflow-x: clip;
  }

  .features-container {
    max-width: 960px;
    margin: 0 auto;
    padding: 0 28px;
  }

  .features-header {
    margin-bottom: 64px;
  }

  .features-title {
    font-size: clamp(1.85rem, 3.2vw, 2.4rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.25;
    color: var(--color-text-primary);
    margin: 0;
  }

  /* ==========================================================================
     Alternating Feature Rows
     ========================================================================== */
  .feature-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 56px;
    margin-bottom: 104px;
  }

  .feature-row-reverse .feature-visual {
    order: 2;
  }

  .feature-row-reverse .feature-copy-block {
    order: 1;
  }

  .feature-copy-block {
    max-width: 400px;
  }

  .feature-heading {
    font-size: clamp(1.45rem, 2.5vw, 1.8rem);
    font-weight: 700;
    letter-spacing: -0.015em;
    margin: 0 0 14px;
  }

  .heading-coral {
    color: var(--color-primary);
  }

  .heading-purple {
    color: var(--color-badge-purple);
  }

  .feature-body {
    font-size: 1rem;
    line-height: 1.65;
    color: var(--color-text-secondary);
    margin: 0;
  }

  /* ==========================================================================
     Phone Mockup Frames & Floating Overlays
     ========================================================================== */
  .feature-visual {
    display: flex;
    justify-content: center;
  }

  .phone-wrap {
    position: relative;
    display: inline-flex;
    justify-content: center;
  }

  .feature-phone {
    width: 220px;
    border-radius: 34px;
    padding: 8px;
    box-shadow: 0 20px 50px var(--shadow-card-active);
  }

  .bezel-coral {
    background-color: var(--color-surface-coral-bezel);
  }

  .bezel-lavender {
    background-color: var(--color-surface-lavender);
  }

  .feature-screen {
    width: 100%;
    aspect-ratio: 1080 / 2316;
    border-radius: 26px;
    overflow: hidden;
    background-color: var(--color-screen-bg);
  }

  .feature-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Floating Filter Pills (Row 1) */
  .pill-tag {
    position: absolute;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    background-color: var(--color-primary);
    color: var(--color-on-primary);
    font-size: 0.74rem;
    font-weight: 600;
    padding: 7px 14px;
    border-radius: var(--radius-full);
    white-space: nowrap;
    box-shadow: 0 8px 20px var(--shadow-primary-sm);
    z-index: 3;
  }

  .pill-shield {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background-color: var(--color-gold);
    color: var(--color-text-primary);
    font-size: 0.62rem;
    font-weight: 900;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .pill-new-badge {
    position: absolute;
    top: -12px;
    left: 10px;
    background-color: var(--color-success);
    color: var(--color-on-primary);
    font-size: 0.56rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    padding: 2px 7px;
    border-radius: var(--radius-xs);
  }

  .pill-top-right {
    top: -8px;
    right: -48px;
  }

  .pill-mid-left {
    top: 96px;
    left: -46px;
  }

  .pill-mid-right {
    top: 224px;
    right: -42px;
  }

  .pill-bottom-left {
    bottom: 62px;
    left: -38px;
  }

  /* Floating Pop-out Cards (Rows 2 & 3) */
  .feature-popout {
    position: absolute;
    z-index: 3;
    width: 280px;
    background-color: var(--color-bg);
    border: 1px solid var(--color-outline-variant);
    border-radius: var(--radius-md);
    padding: 12px 14px;
    display: flex;
    align-items: center;
    gap: 12px;
    box-shadow: 0 16px 38px var(--shadow-card-active);
  }

  .popout-left {
    top: 44%;
    left: -64px;
  }

  .popout-center {
    top: 46%;
    left: 50%;
    transform: translateX(-50%);
  }

  .popout-icon {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .popout-icon-purple {
    background-color: var(--color-surface-lavender);
    color: var(--color-badge-purple);
  }

  .popout-icon-coral {
    background-color: var(--color-coral-container);
    color: var(--color-primary);
  }

  .popout-meta {
    flex: 1;
    min-width: 0;
  }

  .popout-label {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin-bottom: 2px;
  }

  .popout-sub {
    font-size: 0.68rem;
    color: var(--color-text-secondary);
    margin-bottom: 6px;
  }

  .popout-track {
    width: 100%;
    height: 5px;
    background-color: var(--color-surface);
    border-radius: var(--radius-full);
    overflow: hidden;
  }

  .popout-fill {
    width: 82%;
    height: 100%;
    border-radius: var(--radius-full);
  }

  .fill-purple {
    background-color: var(--color-badge-purple);
  }

  .fill-coral {
    background-color: var(--color-primary);
  }

  /* ==========================================================================
     Bottom CTA Button
     ========================================================================== */
  .features-cta-wrap {
    display: flex;
    justify-content: center;
    margin-top: -16px;
  }

  .features-cta-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-secondary) 100%);
    color: var(--color-on-primary);
    font-size: 0.96rem;
    font-weight: 700;
    padding: 13px 34px;
    border-radius: var(--radius-full);
    box-shadow: 0 10px 24px var(--shadow-primary-sm);
    transition: transform var(--transition-fast), box-shadow var(--transition-fast), filter var(--transition-fast);
  }

  .features-cta-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 14px 30px var(--shadow-primary-md);
    filter: brightness(1.05);
  }

  /* ==========================================================================
     Responsive
     ========================================================================== */
  @media (max-width: 860px) {
    .features-section {
      padding: 72px 0 28px;
    }

    .features-header {
      text-align: center;
      margin-bottom: 48px;
    }

    .feature-row {
      grid-template-columns: 1fr;
      gap: 36px;
      margin-bottom: 72px;
      text-align: center;
    }

    .feature-row-reverse .feature-visual {
      order: 0;
    }

    .feature-row-reverse .feature-copy-block {
      order: 0;
    }

    .feature-copy-block {
      margin: 0 auto;
    }

    .popout-left {
      left: 50%;
      transform: translateX(-50%);
    }
  }

  @media (max-width: 480px) {
    .pill-top-right {
      right: -14px;
    }

    .pill-mid-left {
      left: -14px;
    }

    .pill-mid-right {
      right: -12px;
    }

    .pill-bottom-left {
      left: -10px;
    }

    .feature-popout {
      width: 244px;
    }
  }
</style>

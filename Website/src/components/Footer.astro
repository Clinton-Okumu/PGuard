---
import Logo from './Logo.astro';

const currentYear = new Date().getFullYear();
---

<footer id="download" class="site-footer-wrapper">
  <!-- Horizon Silhouette Divider (all colors mapped to theme tokens) -->
  <div class="horizon-band" aria-hidden="true">
    <svg
      class="horizon-svg"
      viewBox="0 0 1440 110"
      preserveAspectRatio="none"
      xmlns="http://www.w3.org/2000/svg"
    >
      <!-- Soft coral-blush background hills -->
      <path
        d="M0 110 L0 58 Q110 20 240 62 T500 88 L500 110 Z"
        fill="var(--color-brand-horizon-hill)"
      />
      <path
        d="M1020 110 L1020 80 Q1180 18 1320 42 T1440 24 L1440 110 Z"
        fill="var(--color-brand-horizon-hill)"
      />
      <!-- Main solid footer horizon -->
      <path
        d="M0 84 Q360 72 720 78 T1440 68 L1440 110 L0 110 Z"
        fill="var(--color-brand-canvas)"
      />
    </svg>
  </div>

  <!-- Solid Brand Footer Band -->
  <div class="footer-main">
    <div class="footer-inner">
      <!-- Centered Stacked Brand Logo -->
      <div class="footer-logo-stack">
        <Logo size={42} showText={false} />
        <span class="footer-brand-name">PGuard</span>
      </div>

      <!-- Support Email -->
      <a href="mailto:hello@pguard.app" class="footer-email">
        <span class="email-icon-circle" aria-hidden="true">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="4" width="20" height="16" rx="3" />
            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
          </svg>
        </span>
        <span>hello@pguard.app</span>
      </a>

      <!-- Store & Download Badges -->
      <div class="store-badges" id="download-android">
        <a href="#google-play" class="store-badge" aria-label="Get PGuard on Google Play">
          <svg class="store-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M3.61 1.814L13.793 12 3.61 22.186a1.75 1.75 0 0 1-.61-1.34V3.154c0-.517.224-.998.61-1.34zm11.244 11.247l2.987 2.987-10.89 6.235 7.903-9.222zm3.94-2.192l3.11 1.78c.81.464.81 1.638 0 2.102l-3.11 1.78-3.322-3.322 3.322-2.34zm-3.94-.869L6.95 1.717l10.89 6.235-2.986 2.048z"/>
          </svg>
          <div class="store-text">
            <span class="store-kicker">GET IT ON</span>
            <span class="store-name">Google Play</span>
          </div>
        </a>

        <a href="#direct-apk" class="store-badge" aria-label="Download PGuard Direct APK">
          <svg class="store-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 3v12" />
            <path d="m7 11 5 5 5-5" />
            <path d="M5 20h14" />
          </svg>
          <div class="store-text">
            <span class="store-kicker">DIRECT INSTALL</span>
            <span class="store-name">Android APK</span>
          </div>
        </a>
      </div>

      <!-- Copyright -->
      <p class="footer-copyright">
        &copy; {currentYear} PGuard. All rights reserved.
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer-wrapper {
    width: 100%;
    background-color: var(--color-bg);
    padding-top: 32px;
    overflow-x: clip;
  }

  .horizon-band {
    width: 100%;
    line-height: 0;
    margin-bottom: -1px;
  }

  .horizon-svg {
    width: 100%;
    height: 92px;
    display: block;
  }

  .footer-main {
    background-color: var(--color-brand-canvas);
    color: var(--color-on-brand-canvas);
    padding: 36px 24px 44px;
  }

  .footer-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 20px;
  }

  .footer-logo-stack {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }

  .footer-brand-name {
    font-size: 1.3rem;
    font-weight: 800;
    letter-spacing: -0.3px;
    color: var(--color-on-brand-canvas);
  }

  .footer-email {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.92rem;
    font-weight: 500;
    color: var(--color-on-brand-canvas-muted);
    transition: opacity var(--transition-fast);
  }

  .footer-email:hover {
    opacity: 0.8;
  }

  .email-icon-circle {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background-color: var(--color-brand-glass-bg);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--color-on-brand-canvas);
  }

  .store-badges {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 4px;
  }

  .store-badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 8px 16px;
    border-radius: 10px;
    border: 1px solid var(--color-brand-glass-border);
    background-color: var(--color-brand-badge-bg);
    color: var(--color-on-brand-canvas);
    transition: background-color var(--transition-fast), border-color var(--transition-fast), transform var(--transition-fast);
  }

  .store-badge:hover {
    background-color: var(--color-brand-badge-bg-hover);
    border-color: var(--color-brand-glass-border-hover);
    transform: translateY(-1px);
  }

  .store-icon {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
  }

  .store-text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    line-height: 1.1;
  }

  .store-kicker {
    font-size: 0.56rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--color-on-brand-canvas-subtle);
  }

  .store-name {
    font-size: 0.92rem;
    font-weight: 700;
    color: var(--color-on-brand-canvas);
  }

  .footer-copyright {
    font-size: 0.76rem;
    color: var(--color-on-brand-canvas-faint);
    margin: 8px 0 0;
  }

  @media (max-width: 640px) {
    .horizon-svg {
      height: 60px;
    }
  }
</style>
